# --- App ---
APP_NAME=MediDoor
APP_ENV=development
DEBUG=true

# --- URLs ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
MOBILE_CUSTOMER_URL=http://localhost:3100
MOBILE_PHARMACY_URL=http://localhost:3200
MOBILE_RIDER_URL=http://localhost:3300

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth ---
GOOGLE_CLIENT_ID=PASTE_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=PASTE_YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- AI + Maps ---
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash-lite
BARIKOI_API_KEY=

# --- Database (SQLite by default; switch to Postgres for prod) ---
DATABASE_URL=sqlite+aiosqlite:///./medidoor.db
# DATABASE_URL=postgresql+asyncpg://medidoor:medidoor_dev@localhost:5432/medidoor

# --- Redis (optional in current login system) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# website + mobile-customer (+ planned mobile-pharmacy/rider on 3200/3300)
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3200,http://localhost:3300

# --- Admin ---
ADMIN_GMAILS=admin@medidoor.app
# Password for the web Admin Console at /admin (pick a strong one)
ADMIN_CONSOLE_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
