# Copy this file to backend/.env on the VPS and replace secrets before starting production.

APP_NAME=MediDoor
APP_ENV=production
DEBUG=false

BACKEND_URL=https://api.medidoor.com.bd
FRONTEND_URL=https://medidoor.com.bd
MOBILE_CUSTOMER_URL=https://customer.medidoor.com.bd
MOBILE_PHARMACY_URL=https://pharmacy.medidoor.com.bd
MOBILE_RIDER_URL=https://rider.medidoor.com.bd

SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.medidoor.com.bd/api/auth/google/callback

GEMINI_API_KEY=
GEMINI_API_KEYS=REPLACE_WITH_GEMINI_KEY_OR_COMMA_SEPARATED_KEYS
GEMINI_MODEL=gemini-2.5-flash-lite
BARIKOI_API_KEY=REPLACE_WITH_BARIKOI_SERVER_KEY

DATABASE_URL=postgresql+asyncpg://medidoor:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/medidoor
REDIS_URL=redis://127.0.0.1:6379/0

CORS_ORIGINS=https://medidoor.com.bd,https://www.medidoor.com.bd,https://customer.medidoor.com.bd,https://pharmacy.medidoor.com.bd,https://rider.medidoor.com.bd
ADMIN_GMAILS=REPLACE_WITH_OWNER_GMAIL,REPLACE_WITH_ADMIN_GMAIL
ADMIN_CONSOLE_PASSWORD=REPLACE_WITH_STRONG_ADMIN_CONSOLE_PASSWORD
